# ---------------------------------------------------------------------------
# Variables de entorno — copiar a .env.local (dev) o setear en Railway (prod).
# Ninguna trae valor real acá; este archivo SÍ se commitea.
# ---------------------------------------------------------------------------

# --- Base de datos (Postgres / Railway) ---
# DATABASE_URL: conexión de RUNTIME, va a través de PgBouncer (pool mode =
# transaction). DEBE llevar `?pgbouncer=true&connection_limit=1` para que Prisma
# desactive los prepared statements y no pelee con el bouncer.
DATABASE_URL=postgresql://user:password@host:6432/dbname?pgbouncer=true&connection_limit=1
# DIRECT_URL: conexión DIRECTA a Postgres, SIN pgbouncer (sin `?pgbouncer=true`).
# La usa `prisma migrate` / introspección, que necesitan session-mode (advisory
# locks, DDL con prepared statements).
DIRECT_URL=postgresql://user:password@host:5432/dbname

# --- Auth (next-auth v5) ---
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL pública del sitio (ej: https://traveloz.com.uy)
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# --- Owner admin protegido (scripts/ensure-protected-admin.mjs) ---
PROTECTED_ADMIN_EMAIL=
PROTECTED_ADMIN_NAME=
PROTECTED_ADMIN_PASSWORD=

# --- Storage S3-compatible (Tigris / Railway / MinIO) ---
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# true para MinIO/local:
STORAGE_FORCE_PATH_STYLE=false
# Aliases legacy AWS_* (algunos scripts los leen; apuntar al mismo bucket):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=

# --- Email (Resend) — sin API key, los mails se loguean a consola ---
RESEND_API_KEY=
EMAIL_FROM="TravelOz <no-reply@traveloz.com.uy>"

# --- Reglas de negocio (opcionales, tienen defaults) ---
# Factor mínimo de markup permitido al guardar precios:
MIN_MARKUP_FACTOR=
# Factor que dispara warning (sin bloquear):
WARN_MARKUP_FACTOR=

# --- Cotizador: PDF server-side (Chromium + puppeteer-core) ---
# En 1 apaga la generación de PDF sin deploy: la ruta /api/cotizador/<id>/pdf
# contesta 503 y el email sale igual, con el link y sin adjunto.
COTIZADOR_PDF_OFF=
# Ruta al ejecutable de Chromium. Vacío = se busca solo (chromium,
# chromium-browser, google-chrome). Solo se setea si la imagen lo mueve de lugar.
PUPPETEER_EXECUTABLE_PATH=
# Base por la que el Chromium del server pide la hoja /c/<token>?print=1.
# Vacío es lo correcto casi siempre:
#   • en producción se usa el loopback http://127.0.0.1:$PORT — la request no
#     sale del contenedor, así que no pasa por Cloudflare (que frena al headless
#     y hacía morir todos los renders en el timeout);
#   • en desarrollo se usa APP_URL / NEXTAUTH_URL, como hasta ahora.
# Se setea solo para forzar otra entrada: volver a la URL pública en producción,
# o renderizar el sitio real desde una máquina local
# (COTIZADOR_PDF_BASE_URL=https://traveloz.com.uy). Sin barra final.
COTIZADOR_PDF_BASE_URL=

# --- Cotizador: lector de itinerarios (Gemini) ---
# API key de Google AI Studio. Sin key el lector responde SIN_API_KEY.
GEMINI_API_KEY=
# En 1 apaga el lector con IA: /api/cotizador/leer-itinerario contesta apagado.
COTIZADOR_IA_OFF=
# Modelo de Gemini para el lector (default: gemini-3.1-flash-lite).
GEMINI_MODELO=

# --- Observabilidad ---
# debug | info | warn | error (default: info)
LOG_LEVEL=

# Pasajeros y pagos (bóveda de tarjetas y purga diaria)
# Clave AES de la bóveda: openssl rand -base64 32. Sin ella el formulario de pago no cifra.
DATOS_PAGO_KEY=
# Secreto que manda el cron de purga (GitHub Actions) al endpoint de purga.
PURGA_SECRET=

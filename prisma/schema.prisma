// ──────────────────────────────────────────────
// Datos de pasajeros y datos de pago — links personales por vendedor.
// Cada vendedor tiene dos URLs públicas permanentes (por User.slug):
//   /datos-de-pasajeros/<slug>  → EnvioPasajeros + PasajeroDato
//   /datos-de-pago/<slug>       → DatosPagoCifrado (bóveda 96 h)
// ──────────────────────────────────────────────

enum TipoFormularioDato {
  PASAJEROS
  PAGO
}

// Definición editable de cada formulario (dos filas, una por tipo). `campos`
// usa el mismo contrato FormField del cotizador (src/lib/cotizador-form.ts)
// para los campos EXTRA que el admin agregue; los campos duros del pasajero
// van tipados en PasajeroDato. `publicado: false` → la página pública responde
// "no disponible" (así se deploya sin que nadie lo vea).
model FormularioDato {
  id        String             @id @default(cuid())
  tipo      TipoFormularioDato @unique
  titulo    String
  texto     String?            @db.Text
  campos    Json               @default("[]")
  publicado Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

// Un envío dirigido a un pasajero concreto (botón "Enviar por email" del
// vendedor). El link permanente NO pasa por acá. Token de un solo uso en la
// URL (?s=<token>): precarga destinatario y sella completadoAt al enviar.
// Referencias a User como String suelto, misma convención que asignadoAUserId.
model SolicitudDato {
  id                 String             @id @default(cuid())
  tipo               TipoFormularioDato
  vendedorId         String
  vendedorEmail      String
  vendedorNombre     String
  destinatarioEmail  String
  destinatarioNombre String?
  destino            String?
  referencia         String?
  token              String             @unique
  enviadoAt          DateTime           @default(now())
  expiraAt           DateTime
  completadoAt       DateTime?

  @@index([vendedorId, enviadoAt(sort: Desc)])
}

// El grupo que llegó de una sola pasada por el formulario de pasajeros.
// Facturación con RUT solo si marcaron la casilla. vistoAt se sella al abrir
// el detalle (marca automática, no manual como en Leads).
model EnvioPasajeros {
  id                 String    @id @default(cuid())
  vendedorId         String
  vendedorEmail      String
  solicitudId        String?
  destino            String?
  referencia         String?
  facturaRut         String?
  facturaRazonSocial String?
  facturaEmail       String?
  facturaDireccion   String?
  vistoAt            DateTime?
  createdAt          DateTime  @default(now())
  ip                 String?
  userAgent          String?

  pasajeros PasajeroDato[]

  @@index([vendedorId, createdAt(sort: Desc)])
  @@index([destino])
  @@index([createdAt(sort: Desc)])
}

// Un pasajero dentro de un envío. Campos duros tipados (se buscan y exportan);
// `respuestas` guarda solo los campos extra definidos en FormularioDato.
// Los archivos van a S3 bajo un prefijo que exige sesión para descargar.
model PasajeroDato {
  id                  String    @id @default(cuid())
  envioId             String
  orden               Int       @default(0)
  nombres             String
  apellidos           String
  fechaNacimiento     DateTime?
  documento           String
  pasaporte           String?
  email               String
  telefono            String
  direccion           String?
  pais                String?
  ciudad              String?
  documentoArchivoUrl String?
  pasaporteArchivoUrl String?
  respuestas          Json      @default("[]")

  envio EnvioPasajeros @relation(fields: [envioId], references: [id], onDelete: Cascade)

  @@index([envioId])
  @@index([email])
}

// Bóveda de datos de tarjeta. El payload (PAN, vencimiento, CVV, documento)
// viaja cifrado AES-256-GCM con DATOS_PAGO_KEY; iv y tag por registro. A las
// 96 h el barrido pone payload/iv/tag en null y sella purgadoAt — la fila
// sobrevive como registro (titular, emisor, ultimos4, fechas). NUNCA se
// loguea el cuerpo del request ni se persiste el número en claro.
model DatosPagoCifrado {
  id                   String    @id @default(cuid())
  vendedorId           String
  vendedorEmail        String
  solicitudId          String?
  titular              String
  // Pasajero al que corresponde el pago. Va EN CLARO (no entra al sobre
  // cifrado): es el nombre con el que el vendedor y ADM identifican el
  // registro, y muchas veces no coincide con el titular de la tarjeta.
  pasajeroNombre       String?
  pasajeroDocumento    String?
  emisor               String?
  ultimos4             String
  payload              Bytes?
  iv                   Bytes?
  tag                  Bytes?
  // Versión de DATOS_PAGO_KEY con la que se cifró este registro. Permite
  // rotar la clave sin perder los registros vivos: la nueva escribe v2 y la
  // lectura elige la clave según esta columna.
  keyVersion           Int       @default(1)
  // ID del email recordatorio agendado en Resend (24 h antes de expirar);
  // se cancela contra la API si el vendedor abre la bóveda antes.
  recordatorioResendId String?
  createdAt            DateTime  @default(now())
  expiraAt             DateTime
  vistoAt              DateTime?
  purgadoAt            DateTime?
  // Envío a Administración: el vendedor manda los datos a la casilla de ADM
  // con el número de file del expediente. No borra la tarjeta (sigue viva
  // hasta expiraAt) y queda auditado en AuditLog.
  numeroFile           String?
  enviadoAdmAt         DateTime?
  enviadoAdmPor        String?

  @@index([vendedorId, createdAt(sort: Desc)])
  @@index([expiraAt])
}

// ──────────────────────────────────────────────
// Cotizador del vendedor — persistencia híbrida.
//
// La cotización entera (destinos, opciones, habitaciones, tarifas, vuelos,
// servicios, mensaje) vive en `contenido Json`, validado con Zod en
// src/lib/presupuesto/schema.ts. Las columnas de acá son un espejo derivado
// de ese JSON: existen SOLO para listar, filtrar y ordenar sin abrir el blob.
// Nada de normalizar opciones ni tarifas en tablas: cambian todo el tiempo y
// el vendedor las arma libres.
//
// El modelo se llama Presupuesto porque `Cotizacion` ya es el lead del sitio
// público. En la UI se sigue diciendo "cotización".
// ──────────────────────────────────────────────

enum EstadoPresupuesto {
  BORRADOR
  ENVIADA
  ABIERTA
  VENCIDA
  CONFIRMADA
}

model Presupuesto {
  id         String @id @default(cuid())
  // Correlativo visible: COT-2026-0148. Lo genera IdCounter por año.
  numero     String @unique
  brandId    String
  vendedorId String

  // Idempotencia del alta. El editor genera un UUID por cotización nueva y lo
  // manda en cada intento de creación: si la respuesta se perdió en el camino
  // y el cliente reintenta, el unique hace que la segunda llamada devuelva la
  // fila que ya existe en vez de duplicarla y quemar otro número.
  claveEdicion String? @unique

  // Estado real. `estadoManual` lo pisa cuando el vendedor lo fija a mano;
  // la "vencida automática" (enviada, sin abrir, pasada la vigencia) NO se
  // persiste: se calcula en el cliente contra expiraAt.
  estado       EstadoPresupuesto  @default(BORRADOR)
  estadoManual EstadoPresupuesto?

  // Espejo del cliente. `clienteTelefonoDigitos` guarda solo los dígitos para
  // que "+598 99 123 456", "099123456" y "99123456" matcheen igual.
  clienteNombre          String?
  clienteApellido        String?
  clienteEmail           String?
  clienteTelefono        String?
  clienteTelefonoDigitos String?

  // Espejo del encabezado del viaje.
  destino     String?
  mes         Int?
  anio        Int?
  fechaSalida DateTime? @db.Date
  soloVuelos  Boolean   @default(false)

  // Precio que se muestra en la lista: primera tarifa de la primera
  // habitación de la primera opción (venta ?? round(neto / factor)).
  montoPrincipal Int?
  moneda         String @default("USD")

  // De dónde salió: paquete del catálogo, plantilla, duplicada, consulta IA.
  origenTipo String?
  origenRef  String?

  contenido     Json
  notasInternas String? @db.Text

  vigenciaHoras     Int       @default(48)
  enviadaAt         DateTime?
  expiraAt          DateTime?
  confirmadaAt      DateTime?
  confirmadaOpcion  String?
  confirmadaVia     String?
  aperturas         Int       @default(0)
  primeraAperturaAt DateTime?
  ultimaAperturaAt  DateTime?
  // Cuánto tardó el vendedor en armarla (métrica del panel).
  tiempoArmadoSeg   Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vendedor User                @relation(fields: [vendedorId], references: [id], onDelete: Restrict)
  eventos  PresupuestoEvento[]
  links    PresupuestoLink[]

  @@index([brandId, vendedorId, deletedAt])
  @@index([brandId, estado])
  @@index([numero])
  @@index([clienteTelefonoDigitos])
}

// Bitácora append-only de la cotización: es lo que se dibuja en la línea de
// tiempo del drawer. `tipo` es un string libre por convención:
//   creada | guardada | enviada | abierta | recordatorio | vigencia_extendida
//   reactivada | estado_manual | confirmada | revision_solicitada | duplicada
//   eliminada
model PresupuestoEvento {
  id            String   @id @default(cuid())
  presupuestoId String
  tipo          String
  titulo        String
  detalle       String?
  // vendedor | pasajero | sistema
  actorTipo     String
  actorId       String?
  ocurridoAt    DateTime @default(now())

  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@index([presupuestoId, ocurridoAt])
}

// Link público que se le manda al pasajero. Uno por envío: reenviar emite
// otro y el anterior se revoca, así el seguimiento no mezcla aperturas.
model PresupuestoLink {
  id            String    @id @default(cuid())
  presupuestoId String
  token         String    @unique
  // whatsapp | email | pdf | manual
  canal         String
  vigenciaHoras Int
  emitidoAt     DateTime  @default(now())
  expiraAt      DateTime
  revocadoAt    DateTime?

  presupuesto Presupuesto           @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  aperturas   PresupuestoApertura[]

  @@index([presupuestoId])
}

// Cada vez que alguien abre el link. `seccionMax` y `segundos` alimentan el
// funnel de lectura ("llegó hasta Formas de pago, 2 m 40 s").
model PresupuestoApertura {
  id          String   @id @default(cuid())
  linkId      String
  abiertaAt   DateTime @default(now())
  userAgent   String?
  dispositivo String?
  ip          String?
  seccionMax  String?
  segundos    Int?

  link PresupuestoLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, abiertaAt])
}

// Cotización guardada como punto de partida. `vendedorId` null = plantilla
// global del equipo; con id, privada de quien la creó.
model PlantillaPresupuesto {
  id         String  @id @default(cuid())
  brandId    String
  nombre     String
  destino    String?
  detalle    String?
  vendedorId String?

  contenido   Json
  usos        Int       @default(0)
  ultimoUsoAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([brandId, deletedAt])
  @@index([vendedorId])
}

// Hoteles que el vendedor marcó con la estrella: suben primero en el buscador.
model HotelFavorito {
  vendedorId    String
  alojamientoId String
  createdAt     DateTime @default(now())

  vendedor    User        @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  alojamiento Alojamiento @relation(fields: [alojamientoId], references: [id], onDelete: Cascade)

  @@id([vendedorId, alojamientoId])
  @@index([alojamientoId])
}

// Catálogo IATA mínimo para el bloque de vuelos: el parser de PNR devuelve
// códigos y acá se traducen a ciudad, terminal y aerolínea.
model Aeropuerto {
  // IATA de 3 letras (MVD, GRU, PUJ…).
  codigo   String  @id
  ciudad   String
  nombre   String
  // Nombre de la terminal cuando la ciudad tiene más de una (Guarulhos).
  terminal String?
}

model Aerolinea {
  // IATA de 2 caracteres (LA, CM, G3…).
  codigo String @id
  nombre String
}

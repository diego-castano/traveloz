// TravelOz Travel Agency Admin Panel - Prisma Schema
// PostgreSQL on Railway

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through PgBouncer (pool mode = transaction).
  // Add `?pgbouncer=true&connection_limit=1` to DATABASE_URL so Prisma
  // disables prepared statements and won't fight the bouncer.
  url       = env("DATABASE_URL")
  // Migrations and introspection bypass the bouncer because they need
  // session-mode features (advisory locks, prepared DDL). Point DIRECT_URL
  // at the raw Postgres URL (no `?pgbouncer=true`).
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum EstadoPaquete {
  BORRADOR
  EN_REVISION
  ACTIVO
  ARCHIVADO
}

enum TipoTraslado {
  REGULAR
  PRIVADO
}

// Modalidad de armado del paquete:
//   CLASICO  → precio derivado de opciones hoteleras (comportamiento histórico).
//   CIRCUITO → todo incluido con precio único por persona cargado en el circuito;
//              el precio NO depende de OpcionHotelera.
enum ModalidadPaquete {
  CLASICO
  CIRCUITO
}

enum CategoriaServicio {
  TRASLADOS
  SEGUROS
  CIRCUITOS
  HOTELES
}

enum Role {
  ADMIN
  VENDEDOR
  MARKETING
}

enum EstadoMensaje {
  NUEVO
  LEIDO
  RESPONDIDO
  CERRADA
}

enum CanalContacto {
  LLAMADA
  EMAIL
  WHATSAPP
}

// Cómo terminó el push del lead al CRM (Bitrix24). PENDIENTE se escribe al
// crear la cotización, antes de intentar el envío: si el request se muere en
// el medio, la marca queda y se ve que nunca se confirmó.
enum CrmEstado {
  PENDIENTE
  OK
  ERROR
}

// ──────────────────────────────────────────────
// Models
// ──────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  // 4-6 digit numeric PIN (bcrypt-hashed). Null = user has no PIN configured yet.
  pinHash              String?
  name                 String
  role                 Role      @default(VENDEDOR)
  brandId              String
  isActive             Boolean   @default(true)
  // Brute-force protection. Reset on successful auth.
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  // Self-service password reset (one-time token, 60-min TTL).
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  // Permanent global admin — cannot be demoted, deactivated, or deleted via UI.
  isProtected          Boolean   @default(false)
  // ── Identidad pública del vendedor (links de datos de pasajeros/pago) ──
  // Slug del link personal: traveloz.com.uy/datos-de-pasajeros/<slug>.
  // Nunca se recicla entre personas: si alguien se va, su slug queda muerto.
  slug                 String?   @unique
  fotoUrl              String?
  telefono             String?
  whatsapp             String?
  // Texto de la firma en la cotización ("Ejecutiva de ventas", "Líder técnico").
  cargo                String?
  // Firma de email institucional (GIF animado 1800x585). Pedido del cliente
  // 28/08: el vendedor la carga desde Perfiles y se usa tal cual en la hoja de
  // la cotización y en los emails que le llegan al pasajero.
  firmaUrl             String?
  // Interruptor del link público. Apagado → página de cortesía, no 404.
  linkActivo           Boolean   @default(true)
  // Primer ingreso con contraseña temporal (seed del equipo). El usuario
  // elige entre cambiarla o seguir con la temporal; ambas limpian el flag.
  mustChangePassword   Boolean   @default(false)
  passwordChangedAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  presupuestos     Presupuesto[]
  hotelesFavoritos HotelFavorito[]

  @@index([brandId])
}

// Append-only log of security-relevant events: user CRUD, role changes,
// login success/failure, password / PIN changes, account lockouts.
model AuditLog {
  id         String   @id @default(cuid())
  // Actor (may be null for failed logins where the email doesn't exist).
  userId     String?
  userEmail  String?
  // Dotted-namespace event name, e.g. "user.create", "login.success",
  // "login.fail.bad_password", "password.change.self", "pin.set", "user.lock".
  action     String
  // Optional target (e.g. when an admin edits another user).
  targetType String?
  targetId   String?
  // Free-form JSON for event-specific fields (changed columns, IP, attempt #).
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  // Historial de un objeto puntual (los accesos a una tarjeta de la bóveda).
  @@index([targetType, targetId, createdAt(sort: Desc)])
}

model Paquete {
  id                String           @id
  brandId           String
  titulo            String
  destino           String
  descripcion       String?          @db.Text
  textoVisual       String?          @db.Text
  salidas           String?
  noches            Int              @default(0)
  temporadaId       String?
  tipoPaqueteId     String?
  validezDesde      String?
  validezHasta      String?
  // ── Período de viaje real (cuándo viaja el cliente). Distinto de validez
  //    (que controla el listing en el frontend). Los servicios y precios se
  //    matchean contra este rango.
  viajeDesde        String?
  viajeHasta        String?
  estado            EstadoPaquete    @default(BORRADOR)
  // Modalidad de armado: CLASICO (opciones hoteleras) o CIRCUITO (todo incluido,
  // precio por persona cargado en el circuito, sin exigir opciones).
  modalidad         ModalidadPaquete @default(CLASICO)
  destacado         Boolean          @default(false)
  netoCalculado     Float            @default(0)
  markup            Float            @default(0)
  precioVenta       Float            @default(0)
  moneda            String           @default("USD")
  ordenServicios    String[]
  webId             String?
  itinerarioAmadeus String?          @db.Text
  campana           String?

  // ── Public-site copy (Fase 5C/8: edited from /backend/paquetes/[slug]?tab=frontend) ──
  slug              String? @unique
  publicado         Boolean @default(false)
  metaTitle         String?
  metaDescription   String? @db.Text
  heroImage         String?
  // Texto introductorio del paquete (aparece arriba/al lado del título en el detalle público)
  textoIntro        String? @db.Text
  // Texto introductorio de la lista "Incluye"
  textoIncluye      String? @db.Text
  // Renglones custom de la tarjeta en grillas/listados (array de strings).
  // null/vacío → se derivan automáticos de textoIncluye via buildCardBullets.
  cardBullets       Json?
  // Itinerario día a día visible públicamente (distinto al itinerarioAmadeus interno)
  itinerarioPublico String? @db.Text
  // Notas de condiciones/cancelación específicas del paquete
  textoCondiciones  String? @db.Text
  precioDesde       Float?
  precioDesdeMoneda String? @default("USD")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  temporada          Temporada?           @relation(fields: [temporadaId], references: [id])
  tipoPaquete        TipoPaquete?         @relation(fields: [tipoPaqueteId], references: [id])
  fotos              PaqueteFoto[]
  etiquetas          PaqueteEtiqueta[]
  aereos             PaqueteAereo[]
  alojamientos       PaqueteAlojamiento[]
  traslados          PaqueteTraslado[]
  seguros            PaqueteSeguro[]
  circuitos          PaqueteCircuito[]
  opcionesHoteleras  OpcionHotelera[]
  destinos           PaqueteDestino[]
  serviciosIncluidos PaqueteServicio[]
  testimonios        Testimonio[]
  cotizaciones       Cotizacion[]

  @@index([brandId])
  @@index([estado])
  @@index([deletedAt])
  @@index([temporadaId])
  @@index([tipoPaqueteId])
  @@index([publicado])
  // Composite — every list query filters by (brandId, deletedAt) and sorts by
  // createdAt DESC. With this Postgres can satisfy the WHERE + ORDER BY
  // straight from the index without a separate sort step.
  @@index([brandId, deletedAt, createdAt(sort: Desc)])
  // Speeds up the wave-2 sub-entity joins that constrain on the parent
  // Paquete being live (brandId + not soft-deleted).
  @@index([brandId, deletedAt])
}

model Aereo {
  id                 String    @id
  brandId            String
  ruta               String
  destino            String
  aerolinea          String?
  equipaje           String?
  itinerario         String?
  itinerarioImagenes String[]  @default([])
  escalas            Int       @default(0)
  codigoVueloIda     String?
  codigoVueloVuelta  String?
  duracionIda        String?
  duracionVuelta     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  precios  PrecioAereo[]
  paquetes PaqueteAereo[]

  @@index([brandId])
  @@index([brandId, deletedAt])
}

model PrecioAereo {
  id           String    @id @default(cuid())
  aereoId      String
  periodoDesde String
  periodoHasta String
  precioAdulto Float
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  aereo Aereo @relation(fields: [aereoId], references: [id], onDelete: Cascade)

  @@index([aereoId, periodoDesde, periodoHasta])
  @@index([deletedAt])
}

model Alojamiento {
  id             String    @id
  brandId        String
  nombre         String
  ciudadId       String?
  paisId         String?
  categoria      Int?
  categoriaTexto String?
  sitioWeb       String?
  comentarios    String?
  ubicacion      String?
  aclaracion     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  precios       PrecioAlojamiento[]
  fotos         AlojamientoFoto[]
  ciudad        Ciudad?              @relation(fields: [ciudadId], references: [id])
  pais          Pais?                @relation(fields: [paisId], references: [id])
  paquetes      PaqueteAlojamiento[]
  opcionHoteles OpcionHotel[]
  favoritos     HotelFavorito[]

  @@index([brandId])
  @@index([brandId, deletedAt])
}

model PrecioAlojamiento {
  id             String    @id @default(cuid())
  alojamientoId  String
  periodoDesde   String
  periodoHasta   String
  precioPorNoche Float
  regimenId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  alojamiento Alojamiento @relation(fields: [alojamientoId], references: [id], onDelete: Cascade)
  regimen     Regimen?    @relation(fields: [regimenId], references: [id])

  @@index([alojamientoId, periodoDesde, periodoHasta])
  @@index([deletedAt])
}

model AlojamientoFoto {
  id            String @id @default(cuid())
  alojamientoId String
  url           String
  alt           String
  orden         Int    @default(0)

  alojamiento Alojamiento @relation(fields: [alojamientoId], references: [id], onDelete: Cascade)

  @@index([alojamientoId])
}

model Traslado {
  id          String       @id
  brandId     String
  nombre      String
  tipo        TipoTraslado @default(REGULAR)
  ciudadId    String?
  paisId      String?
  proveedorId String?
  precio      Float
  imagenes    String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  proveedor Proveedor?        @relation(fields: [proveedorId], references: [id])
  ciudad    Ciudad?           @relation(fields: [ciudadId], references: [id])
  pais      Pais?             @relation(fields: [paisId], references: [id])
  paquetes  PaqueteTraslado[]

  @@index([brandId])
  @@index([brandId, deletedAt])
}

model Seguro {
  id          String    @id
  brandId     String
  proveedorId String?
  plan        String
  cobertura   String?
  costoPorDia Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  proveedor Proveedor?      @relation(fields: [proveedorId], references: [id])
  paquetes  PaqueteSeguro[]

  @@index([brandId])
  @@index([brandId, deletedAt])
}

model Circuito {
  id          String    @id
  brandId     String
  nombre      String
  noches      Int
  proveedorId String?
  /// Texto libre interno del circuito (operador que lo maneja, contacto,
  /// aclaraciones de la salida). Se muestra en el módulo de vendedores.
  notas       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  itinerario CircuitoDia[]
  precios    PrecioCircuito[]
  proveedor  Proveedor?        @relation(fields: [proveedorId], references: [id])
  paquetes   PaqueteCircuito[]

  @@index([brandId])
  @@index([brandId, deletedAt])
}

model CircuitoDia {
  id          String  @id @default(cuid())
  circuitoId  String
  numeroDia   Int
  titulo      String
  descripcion String? @db.Text
  orden       Int     @default(0)

  circuito Circuito @relation(fields: [circuitoId], references: [id], onDelete: Cascade)
}

model PrecioCircuito {
  id           String    @id @default(cuid())
  circuitoId   String
  periodoDesde String
  periodoHasta String
  precio       Float
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  circuito Circuito @relation(fields: [circuitoId], references: [id], onDelete: Cascade)

  @@index([circuitoId, periodoDesde, periodoHasta])
  @@index([deletedAt])
}

model Proveedor {
  id        String            @id @default(cuid())
  brandId   String
  nombre    String
  contacto  String?
  email     String?
  telefono  String?
  ejecutivo String?
  whatsapp  String?
  notas     String?           @db.Text
  servicio  CategoriaServicio
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  traslados         Traslado[]
  seguros           Seguro[]
  circuitos         Circuito[]
  opcionesHoteleras OpcionHotelera[]

  @@index([brandId])
}

model Temporada {
  id        String   @id @default(cuid())
  brandId   String
  nombre    String
  orden     Int      @default(0)
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paquetes Paquete[]

  @@unique([brandId, nombre])
  @@index([brandId])
}

model TipoPaquete {
  id        String   @id @default(cuid())
  brandId   String
  nombre    String
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paquetes Paquete[]

  @@unique([brandId, nombre])
  @@index([brandId])
}

model Etiqueta {
  id        String   @id @default(cuid())
  brandId   String
  nombre    String
  slug      String
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paquetes       PaqueteEtiqueta[]
  notificaciones Notificacion[]

  @@unique([brandId, slug])
  @@index([brandId])
}

model Region {
  id          String   @id @default(cuid())
  brandId     String
  nombre      String
  slug        String
  orden       Int      @default(0)
  // ── Public-site copy ──
  heroImage   String?
  descripcion String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  paises Pais[]

  @@unique([brandId, slug])
  @@index([brandId])
}

model Pais {
  id        String   @id @default(cuid())
  brandId   String
  nombre    String
  codigo    String?
  regionId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region       Region?       @relation(fields: [regionId], references: [id])
  ciudades     Ciudad[]
  alojamientos Alojamiento[]
  traslados    Traslado[]

  @@index([brandId])
  @@index([regionId])
}

model Ciudad {
  id        String   @id @default(cuid())
  paisId    String
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pais            Pais             @relation(fields: [paisId], references: [id])
  alojamientos    Alojamiento[]
  traslados       Traslado[]
  paqueteDestinos PaqueteDestino[]
}

model Regimen {
  id        String   @id @default(cuid())
  brandId   String
  nombre    String
  abrev     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  precios PrecioAlojamiento[]

  @@unique([brandId, nombre])
  @@index([brandId])
}

// ──────────────────────────────────────────────
// Junction / Assignment Tables
// ──────────────────────────────────────────────

model PaqueteAereo {
  id           String  @id @default(cuid())
  paqueteId    String
  aereoId      String
  textoDisplay String?
  orden        Int     @default(0)

  paquete Paquete @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  aereo   Aereo   @relation(fields: [aereoId], references: [id])

  @@unique([paqueteId, aereoId])
}

model PaqueteAlojamiento {
  id            String  @id @default(cuid())
  paqueteId     String
  alojamientoId String
  textoDisplay  String?
  orden         Int     @default(0)

  paquete     Paquete     @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  alojamiento Alojamiento @relation(fields: [alojamientoId], references: [id])

  @@unique([paqueteId, alojamientoId])
}

model PaqueteTraslado {
  id           String  @id @default(cuid())
  paqueteId    String
  trasladoId   String
  textoDisplay String?
  orden        Int     @default(0)

  paquete  Paquete  @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  traslado Traslado @relation(fields: [trasladoId], references: [id])

  @@unique([paqueteId, trasladoId])
}

model PaqueteSeguro {
  id            String  @id @default(cuid())
  paqueteId     String
  seguroId      String
  diasCobertura Int?
  textoDisplay  String?
  orden         Int     @default(0)

  paquete Paquete @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  seguro  Seguro  @relation(fields: [seguroId], references: [id])

  @@unique([paqueteId, seguroId])
}

model PaqueteCircuito {
  id           String  @id @default(cuid())
  paqueteId    String
  circuitoId   String
  textoDisplay String?
  orden        Int     @default(0)

  paquete  Paquete  @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  circuito Circuito @relation(fields: [circuitoId], references: [id])

  @@unique([paqueteId, circuitoId])
}

model PaqueteFoto {
  id        String @id @default(cuid())
  paqueteId String
  url       String
  alt       String
  orden     Int    @default(0)
  // Punto focal del recorte (object-position en %) y zoom, para reencuadrar la
  // foto en el hero/slider sin redimensionar el archivo. 50/50/1 = centrado.
  posX      Float  @default(50)
  posY      Float  @default(50)
  zoom      Float  @default(1)

  paquete Paquete @relation(fields: [paqueteId], references: [id], onDelete: Cascade)

  @@index([paqueteId])
}

model PaqueteEtiqueta {
  id         String @id @default(cuid())
  paqueteId  String
  etiquetaId String

  paquete  Paquete  @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  etiqueta Etiqueta @relation(fields: [etiquetaId], references: [id])

  @@unique([paqueteId, etiquetaId])
}

model OpcionHotelera {
  id           String  @id @default(cuid())
  paqueteId    String
  nombre       String
  factor       Float
  precioVenta  Float
  orden        Int     @default(0)
  proveedorId  String?
  /**
   * Optional custom blurb shown publicly with this option (e.g. "All Inclusive 5★").
   */
  textoDisplay String?

  paquete   Paquete       @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  proveedor Proveedor?    @relation(fields: [proveedorId], references: [id])
  hoteles   OpcionHotel[]

  @@index([paqueteId])
}

// ──────────────────────────────────────────────
// Itinerary & per-destino hotel selection (new model, PR 1)
// ──────────────────────────────────────────────

model PaqueteDestino {
  id        String @id @default(cuid())
  paqueteId String
  ciudadId  String
  noches    Int
  orden     Int    @default(0)

  paquete       Paquete       @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  ciudad        Ciudad        @relation(fields: [ciudadId], references: [id])
  opcionHoteles OpcionHotel[]

  @@unique([paqueteId, ciudadId, orden])
  @@index([paqueteId])
}

model OpcionHotel {
  id               String @id @default(cuid())
  opcionHoteleraId String
  destinoId        String
  alojamientoId    String
  orden            Int    @default(0)

  opcion      OpcionHotelera @relation(fields: [opcionHoteleraId], references: [id], onDelete: Cascade)
  destino     PaqueteDestino @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  alojamiento Alojamiento    @relation(fields: [alojamientoId], references: [id])

  @@unique([opcionHoteleraId, destinoId])
  @@index([opcionHoteleraId])
  @@index([destinoId])
}

// ──────────────────────────────────────────────
// Notification history
// ──────────────────────────────────────────────

model Notificacion {
  id         String   @id @default(cuid())
  brandId    String
  etiquetaId String
  paqueteIds String[]
  mensaje    String?  @db.Text
  enviadoAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  etiqueta Etiqueta @relation(fields: [etiquetaId], references: [id])

  @@index([brandId])
}

// ──────────────────────────────────────────────
// Public site editable content (single-tenant — no brandId)
// ──────────────────────────────────────────────

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  type      String   @default("text") // "text" | "textarea" | "image_url" | "number" | "url"
  label     String?
  group     String? // "home" | "general" | "corporativo" | etc.
  updatedAt DateTime @updatedAt

  @@index([group])
}

model Testimonio {
  id        String   @id @default(cuid())
  paqueteId String?
  ubicacion String
  titulo    String
  texto     String   @db.Text
  rating    Int      @default(5)
  autor     String
  imageUrl  String?
  publicado Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paquete Paquete? @relation(fields: [paqueteId], references: [id])

  @@index([publicado])
  @@index([orden])
}

model CategoriaDestacada {
  id        String   @id @default(cuid())
  titulo    String
  imagen    String // /site/img/slider-N.webp or external URL
  link      String // e.g. "/destinos?tipo=lunas-de-miel"
  orden     Int      @default(0)
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activa])
}

model CatalogoServicio {
  id          String   @id @default(cuid())
  nombre      String   @unique
  icon        String // "flight" | "bag" | "bus" | "bed" | "exc" | "shield" | …
  descripcion String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  paquetes PaqueteServicio[]

  @@index([activo])
}

model PaqueteServicio {

  aceptaPromos    Boolean        @default(false)
  estado          EstadoMensaje  @default(NUEVO)
  asignadoAUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Atribución de pauta (cookie tvz_attr): snapshot first/last touch al convertir.
  atribFirst  Json?
  atribLast   Json?
  visitanteId String?

  // Estado del push a Bitrix24. Va NULLABLE y SIN default a propósito: los
  // registros anteriores a esta instrumentación quedan en NULL, que significa
  // "no sabemos si llegó al CRM". Un default PENDIENTE mostraría los leads
  // históricos como si nunca hubieran llegado, y eso sería mentira.
  crmEstado    CrmEstado?
  crmDealId    String?
  crmContactId String?
  // Camino que tomó crearNegocioLead: "negocio-nuevo" o "comentario-en-negocio".
  crmModo      String?
  // Mensaje del último fallo, recortado a 500 caracteres y sin el token del
  // webhook (ver mensajeErrorCrm en src/lib/bitrix.ts).
  crmError     String?
  crmEnviadoEn DateTime?
  crmIntentos  Int        @default(0)

  paquete Paquete? @relation(fields: [paqueteId], references: [id])

  @@index([estado])
  @@index([createdAt(sort: Desc)])
  @@index([email])
  // Auditoría del CRM: "los últimos N días con crmEstado PENDIENTE o ERROR".
  @@index([crmEstado, createdAt(sort: Desc)])
}


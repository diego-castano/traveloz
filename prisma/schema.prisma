model SuscripcionNewsletter {
  id               String    @id @default(cuid())
  email            String    @unique
  source           String?
  // Double opt-in (F4): los altas nuevas nacen con active=false + un token de
  // confirmación. Recién quedan active=true (y confirmedAt seteado) cuando el
  // suscriptor abre el link "confirmá tu suscripción". Evita que alguien
  // suscriba un email ajeno y nos genere spam complaints al enchufar campañas.
  active           Boolean   @default(false)
  confirmToken     String?   @unique
  confirmedAt      DateTime?
  createdAt        DateTime  @default(now())
  unsubscribedAt   DateTime?
  // LGPD / GDPR / Ley 18.331 (UY) — prueba de consentimiento al opt-in.
  // IP y user-agent del request que disparó el submit, más la URL completa
  // con UTM params. Útil para responder un pedido de la autoridad
  // regulatoria mostrando que el consentimiento fue explícito.
  consentIp        String?
  consentUserAgent String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?

  // Atribución de pauta (cookie tvz_attr): snapshot first/last touch al convertir.
  // Convive con las columnas utm* de arriba, que son otra cosa: el snapshot legal
  // de consentimiento al opt-in (Ley 18.331). Esta es la señal de marketing.
  atribFirst  Json?
  atribLast   Json?
  visitanteId String?

  @@index([active])
}

// ──────────────────────────────────────────────
// Cotizadores por marca — landings de cotización independientes del sitio
// principal. Cada uno vive en /[slug], con branding propio y sin links de
// navegación (no se puede salir del landing). Se usan para que el cliente
// empiece a captar leads aunque el sitio de TravelOz siga en "Próximamente".

  slug               String    @unique
  nombreMarca        String
  logoUrl            String?
  // Título del hero del landing (editable). Default "Cotizá tu viaje".
  tituloHero         String?
  // Dato institucional breve mostrado arriba del formulario (lean).
  textoInstitucional String?   @db.Text
  // Color para teñir el CTA / acentos del landing (hex). Opcional.
  colorPrimario      String?
  // Emails a los que se notifica cada envío. El envío real se cablea cuando
  // Resend esté configurado; por ahora los leads quedan en DB.
  emailsDestino      String[]  @default([])
  // Definición del formulario, configurable por el admin (constructor sin
  // código). Array de FormField (ver src/lib/cotizador-form.ts). El núcleo de
